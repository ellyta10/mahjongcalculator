    <!-- APPLICATION LOGIC JS -->
    <script>
        // 14 DENOMINATIONS ORDERED FROM 1 TO 10K WITH EXACT COLOR MATCHING FROM REFERENCE IMAGE
        const CHIP_VALUES = [1, 2, 5, 10, 20, 25, 50, 100, 200, 500, '1K', '2K', '5K', '10K'];

        const VEGAS_CHIP_CONFIG = {
            1: { outer: '#84c4db', inner: '#e5f3f8', border: '#ffffff', text: '#0a2342', val: '1', stripe: '#ffffff' },
            2: { outer: '#cc3b98', inner: '#fae3f1', border: '#ffffff', text: '#3c096c', val: '2', stripe: '#f5c6e0' },
            5: { outer: '#d72626', inner: '#fced68', border: '#fffbe8', text: '#1a1d20', val: '5', stripe: '#f2c94c' },
            10: { outer: '#286fc6', inner: '#fbd4aa', border: '#ffeedd', text: '#03071e', val: '10', stripe: '#f3b876' },
            20: { outer: '#3f9680', inner: '#a8ebd7', border: '#dcfaf1', text: '#112236', val: '20', stripe: '#72c7aa' },
            25: { outer: '#218d45', inner: '#86e49f', border: '#ccfbe0', text: '#081c15', val: '25', stripe: '#49be65' },
            50: { outer: '#1b63d8', inner: '#78b58a', border: '#ccfbe0', text: '#0f172a', val: '50', stripe: '#2874fc' },
            100: { outer: '#1c1c22', inner: '#f28531', border: '#fed7aa', text: '#09090b', val: '100', stripe: '#f28531' },
            200: { outer: '#6ce6ba', inner: '#d3f9ee', border: '#ffffff', text: '#064e3b', val: '200', stripe: '#ffffff' },
            500: { outer: '#632e98', inner: '#e19bf5', border: '#fae8ff', text: '#2e1065', val: '500', stripe: '#e19bf5' },
            '1K': { outer: '#e8bc35', inner: '#fef08a', border: '#fffbeb', text: '#451a03', val: '1K', stripe: '#fffbeb' },
            '2K': { outer: '#3d2b21', inner: '#e8d5bc', border: '#f5f5f4', text: '#1c1917', val: '2K', stripe: '#bfa082' },
            '5K': { outer: '#f03db8', inner: '#fcd3ee', border: '#fce7f3', text: '#831843', val: '5K', stripe: '#ffffff' },
            '10K': { outer: '#e8ab8b', inner: '#fdebe3', border: '#fffdfc', text: '#431407', val: '10K', stripe: '#ffffff' }
        };

        function getNumericChipValue(key) {
            if (key === '1K') return 1000;
            if (key === '2K') return 2000;
            if (key === '5K') return 5000;
            if (key === '10K') return 10000;
            return parseInt(key);
        }

        // GLOBAL APPLICATION STATE
        let appState = {
            mainTab: 'calc', // 'calc' or 'recap'
            activeSeat: 'East',
            targetMode: 'starting', // Default startup: 'starting' (Modal Chip)
            multiplier: 1,
            handView: 'stacks', // 'stacks' or 'list'
            soundEnabled: true,
            activeFilter: 'all',
            chipRate: 1000, // Default: 1 chip = Rp 1.000
            playerNames: {
                East: 'Pemain 1',
                South: 'Pemain 2',
                West: 'Pemain 3',
                North: 'Pemain 4'
            },
            players: { East: {}, South: {}, West: {}, North: {} }, // Final chip hand
            startingChips: { East: {}, South: {}, West: {}, North: {} }, // Starting stack chips set via keypad
            history: [],
            log: []
        };

        let audioCtx = null;

        // REALISTIC CERAMIC CHIP AUDIO SYNTHESIZER
        function playChipSound() {
            if (!appState.soundEnabled) return;
            try {
                if (!audioCtx) {
                    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                }
                if (audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }
                
                const now = audioCtx.currentTime;

                const osc1 = audioCtx.createOscillator();
                const gain1 = audioCtx.createGain();
                osc1.type = 'triangle';
                osc1.frequency.setValueAtTime(2400 + Math.random() * 200, now);
                osc1.frequency.exponentialRampToValueAtTime(800, now + 0.04);
                gain1.gain.setValueAtTime(0.2, now);
                gain1.gain.exponentialRampToValueAtTime(0.001, now + 0.04);
                osc1.connect(gain1);
                gain1.connect(audioCtx.destination);
                osc1.start(now);
                osc1.stop(now + 0.04);

                const osc2 = audioCtx.createOscillator();
                const gain2 = audioCtx.createGain();
                osc2.type = 'sine';
                osc2.frequency.setValueAtTime(650 + Math.random() * 50, now);
                osc2.frequency.exponentialRampToValueAtTime(140, now + 0.06);
                gain2.gain.setValueAtTime(0.18, now);
                gain2.gain.exponentialRampToValueAtTime(0.001, now + 0.06);
                osc2.connect(gain2);
                gain2.connect(audioCtx.destination);
                osc2.start(now);
                osc2.stop(now + 0.06);

                if (navigator.vibrate) navigator.vibrate(8);
            } catch (e) {}
        }

        function toggleAudio() {
            appState.soundEnabled = !appState.soundEnabled;
            const icon = document.getElementById('icon-sound');
            if (icon) {
                if (appState.soundEnabled) {
                    icon.setAttribute('data-lucide', 'volume-2');
                    icon.className = 'w-4 h-4 text-[#64866B]';
                } else {
                    icon.setAttribute('data-lucide', 'volume-x');
                    icon.className = 'w-4 h-4 text-[#D77F79]';
                }
                lucide.createIcons();
            }
        }

        // TEXT-TO-SPEECH GREETING: "Rise"
        function speakWelcomeGreeting() {
            if ('speechSynthesis' in window) {
                try {
                    window.speechSynthesis.cancel();
                    const utterance = new SpeechSynthesisUtterance("Rise");
                    utterance.lang = 'en-US';
                    utterance.rate = 0.95;
                    utterance.pitch = 1.1;
                    
                    const voices = window.speechSynthesis.getVoices();
                    const femaleVoice = voices.find(v => v.lang.startsWith('en') && (v.name.includes('Female') || v.name.includes('Samantha') || v.name.includes('Victoria') || v.name.includes('Google US English')));
                    if (femaleVoice) {
                        utterance.voice = femaleVoice;
                    }
                    
                    window.speechSynthesis.speak(utterance);
                } catch (e) {}
            }
        }

        // INITIALIZATION
        window.onload = function() {
            loadSavedState();
            renderChipKeypadGrid();
            renderUI();
            lucide.createIcons();

            setTimeout(() => {
                speakWelcomeGreeting();
            }, 600);

            const playOnFirstTouch = () => {
                speakWelcomeGreeting();
                document.removeEventListener('click', playOnFirstTouch);
                document.removeEventListener('touchstart', playOnFirstTouch);
            };
            document.addEventListener('click', playOnFirstTouch, { once: true });
            document.addEventListener('touchstart', playOnFirstTouch, { once: true });
        };

        // MAIN TAB SWITCHER
        function switchMainTab(tab) {
            appState.mainTab = tab;
            const btnCalc = document.getElementById('tab-btn-calc');
            const btnRecap = document.getElementById('tab-btn-recap');
            const viewCalc = document.getElementById('view-calculator');
            const viewRecap = document.getElementById('view-recap');

            if (tab === 'calc') {
                btnCalc.className = "py-2 px-3 rounded-lg font-bold text-xs transition-all flex items-center justify-center gap-2 bg-[#64866B] text-[#101310]";
                btnRecap.className = "py-2 px-3 rounded-lg font-bold text-xs transition-all flex items-center justify-center gap-2 text-[#A5AA9E] hover:text-[#F0F0E7]";
                viewCalc.classList.remove('hidden');
                viewRecap.classList.add('hidden');
            } else {
                btnRecap.className = "py-2 px-3 rounded-lg font-bold text-xs transition-all flex items-center justify-center gap-2 bg-[#C3A66A] text-[#101310]";
                btnCalc.className = "py-2 px-3 rounded-lg font-bold text-xs transition-all flex items-center justify-center gap-2 text-[#A5AA9E] hover:text-[#F0F0E7]";
                viewRecap.classList.remove('hidden');
                viewRecap.classList.add('flex');
                viewCalc.classList.add('hidden');
            }
            renderUI();
        }

        // GENERATE LAS VEGAS CHIP VECTOR SVG
        function generateChipSVG(valueKey, size = 64) {
            const conf = VEGAS_CHIP_CONFIG[valueKey] || { outer: '#64748b', inner: '#334155', border: '#cbd5e1', text: '#0f172a', val: valueKey.toString(), stripe: '#e2e8f0' };
            return `
                <svg width="${size}" height="${size}" viewBox="0 0 100 100" class="select-none pointer-events-none">
                    <circle cx="50" cy="50" r="47" fill="${conf.outer}" stroke="${conf.border}" stroke-width="2.5" />
                    <g stroke="${conf.stripe}" stroke-width="7" stroke-dasharray="11 15">
                        <circle cx="50" cy="50" r="43" fill="none" opacity="0.9" />
                    </g>
                    <g stroke="#ffffff" stroke-width="3" stroke-dasharray="6 20">
                        <circle cx="50" cy="50" r="43" fill="none" opacity="0.6" />
                    </g>
                    <circle cx="50" cy="50" r="33" fill="${conf.inner}" stroke="${conf.outer}" stroke-width="1.5" />
                    <circle cx="50" cy="50" r="28" fill="#ffffff" stroke="${conf.border}" stroke-width="1.5" class="chip-inlay" />
                    <circle cx="50" cy="50" r="26" fill="#fafafa" opacity="0.95" />
                    <text x="50" y="32" font-family="'Plus Jakarta Sans', sans-serif" font-size="5.5" font-weight="700" fill="#64748b" text-anchor="middle" letter-spacing="0.8">LAS VEGAS</text>
                    <text x="50" y="54" font-family="'JetBrains Mono', monospace" font-size="${conf.val.length > 3 ? '13' : '16'}" font-weight="700" fill="${conf.text}" text-anchor="middle" dominant-baseline="middle">${conf.val}</text>
                    <text x="50" y="71" font-family="'Plus Jakarta Sans', sans-serif" font-size="4.5" font-weight="700" fill="#94a3b8" text-anchor="middle" letter-spacing="0.5">POKER CLUB</text>
                </svg>
            `;
        }

        // RENDER 14 CHIPS MATRIX GRID
        function renderChipKeypadGrid() {
            const grid = document.getElementById('chip-keypad-grid');
            if (!grid) return;
            grid.innerHTML = '';

            CHIP_VALUES.forEach(val => {
                const button = document.createElement('button');
                button.className = `chip-key group aspect-square w-full max-w-[80px] rounded-full flex flex-col items-center justify-center p-1 transition-all`;
                button.onclick = () => addChip(val);
                button.setAttribute('data-chip-val', val);
                button.innerHTML = generateChipSVG(val, 72);
                grid.appendChild(button);
            });
        }

        // FILTER CHIP KEYPAD DENOMINATIONS
        function filterChipGrid(category) {
            appState.activeFilter = category;
            ['all', 'low', 'mid', 'high'].forEach(c => {
                const btn = document.getElementById(`filter-${c}`);
                if (c === category) {
                    btn.className = "text-[10px] px-2 py-0.5 rounded font-bold bg-[#242A23] text-[#C3A66A] border border-[#343B32]";
                } else {
                    btn.className = "text-[10px] px-2 py-0.5 rounded font-medium text-[#777F73] hover:text-[#F0F0E7]";
                }
            });

            const buttons = document.querySelectorAll('#chip-keypad-grid button');
            buttons.forEach(btn => {
                const valKey = btn.getAttribute('data-chip-val');
                const numVal = getNumericChipValue(valKey);
                let show = true;
                if (category === 'low') show = numVal <= 25;
                else if (category === 'mid') show = numVal >= 50 && numVal <= 500;
                else if (category === 'high') show = numVal >= 1000;

                if (show) btn.classList.remove('hidden');
                else btn.classList.add('hidden');
            });
        }

        // SWITCH ACTIVE SEAT
        function switchSeat(seat) {
            appState.activeSeat = seat;
            const seats = ['East', 'South', 'West', 'North'];
            seats.forEach(s => {
                const btn = document.getElementById(`seat-${s}`);
                if (s === seat) {
                    btn.className = "seat-btn flex-1 py-2 px-1 rounded-lg font-semibold text-xs flex flex-col items-center justify-center gap-0.5 transition-all bg-[#64866B] text-[#101310]";
                } else {
                    btn.className = "seat-btn flex-1 py-2 px-1 rounded-lg font-medium text-xs flex flex-col items-center justify-center gap-0.5 transition-all text-[#A5AA9E] hover:text-[#F0F0E7] hover:bg-[#242A23]";
                }
            });

            renderUI();
        }

        // TARGET MODE: 'starting' VS 'hand'
        function setTargetMode(target) {
            appState.targetMode = target;
            const btnStarting = document.getElementById('target-mode-starting');
            const btnHand = document.getElementById('target-mode-hand');

            if (target === 'starting') {
                btnStarting.className = "py-1.5 px-2 rounded font-bold text-xs transition-all flex items-center justify-center gap-1.5 bg-[#C3A66A] text-[#101310]";
                btnHand.className = "py-1.5 px-2 rounded font-bold text-xs transition-all flex items-center justify-center gap-1.5 text-[#A5AA9E] hover:text-[#F0F0E7]";
                showToast("Mode Tuts: Modal Chip", "Modal Chip");
            } else {
                btnHand.className = "py-1.5 px-2 rounded font-bold text-xs transition-all flex items-center justify-center gap-1.5 bg-[#64866B] text-[#101310]";
                btnStarting.className = "py-1.5 px-2 rounded font-bold text-xs transition-all flex items-center justify-center gap-1.5 text-[#A5AA9E] hover:text-[#F0F0E7]";
                showToast("Mode Tuts: Chip On Hand", "Chip On Hand");
            }
            renderUI();
        }

        // TOGGLE HAND TRAY VIEW
        function toggleHandViewMode() {
            appState.handView = appState.handView === 'stacks' ? 'list' : 'stacks';
            const btn = document.getElementById('btn-toggle-view');
            if (appState.handView === 'stacks') {
                btn.innerHTML = `<i data-lucide="layers" class="w-3 h-3 text-[#C3A66A]"></i> Mode Stack 3D`;
            } else {
                btn.innerHTML = `<i data-lucide="list" class="w-3 h-3 text-[#64866B]"></i> Mode Daftar Badge`;
            }
            lucide.createIcons();
            renderUI();
        }

        // ADD CHIPS USING KEYPAD
        function addChip(valueKey) {
            playChipSound();
            const isStartingMode = appState.targetMode === 'starting';
            const targetContainer = isStartingMode ? appState.startingChips : appState.players;
            
            if (!targetContainer[appState.activeSeat]) {
                targetContainer[appState.activeSeat] = {};
            }

            const currentHand = targetContainer[appState.activeSeat];
            const currentQty = currentHand[valueKey] || 0;
            const changeQty = appState.multiplier;

            currentHand[valueKey] = currentQty + changeQty;
            const numVal = getNumericChipValue(valueKey);
            showToast(`+${valueKey} (x${changeQty})`, `+${(numVal * changeQty).toLocaleString('id-ID')}`);

            saveState();
            renderUI();
        }

        // UPDATE PLAYER NAME
        function updateActivePlayerName(newName) {
            if (!newName.trim()) return;
            appState.playerNames[appState.activeSeat] = newName.trim();
            saveState();
            renderUI();
        }

        function getPlayerName(seat) {
            return appState.playerNames[seat] || seat;
        }

        // TOAST FEEDBACK
        let toastTimeout = null;
        function showToast(msg, badgeText) {
            const banner = document.getElementById('toast-banner');
            const name = getPlayerName(appState.activeSeat);
            document.getElementById('toast-msg').innerText = `${msg} [${name}]`;
            document.getElementById('toast-chip-badge').innerText = badgeText;
            
            banner.classList.remove('hidden');
            if (toastTimeout) clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                banner.classList.add('hidden');
            }, 1800);
        }

        // CALCULATE TOTAL CHIP POINTS FOR A SEAT
        function calculateSeatTotal(seat) {
            const hand = appState.players[seat] || {};
            let total = 0;
            for (const [chipKey, qty] of Object.entries(hand)) {
                total += getNumericChipValue(chipKey) * qty;
            }
            return total;
        }

        function calculateSeatStartingTotal(seat) {
            const hand = appState.startingChips[seat] || {};
            let total = 0;
            for (const [chipKey, qty] of Object.entries(hand)) {
                total += getNumericChipValue(chipKey) * qty;
            }
            return total;
        }

        // FORMAT RUPIAH CURRENCY HELPER
        function formatRupiah(number) {
            return new Intl.NumberFormat('id-ID', {
                style: 'currency',
                currency: 'IDR',
                maximumFractionDigits: 0
            }).format(number);
        }

        // RENDER HAND TRAY & RECAP
        function renderUI() {
            const isStartingMode = appState.targetMode === 'starting';
            const currentHand = isStartingMode 
                ? (appState.startingChips[appState.activeSeat] || {}) 
                : (appState.players[appState.activeSeat] || {});

            const activeTotal = calculateSeatTotal(appState.activeSeat);
            const activeStarting = calculateSeatStartingTotal(appState.activeSeat);
            const rate = appState.chipRate || 1000;

            document.getElementById('recap-tab-rate-val').innerText = `1 chip = ${formatRupiah(rate)}`;

            const nameInput = document.getElementById('active-player-name-input');
            if (nameInput && document.activeElement !== nameInput) {
                nameInput.value = getPlayerName(appState.activeSeat);
            }

            const seatTagMap = { East: 'Kursi 1 (Timur)', South: 'Kursi 2 (Selatan)', West: 'Kursi 3 (Barat)', North: 'Kursi 4 (Utara)' };
            if (document.getElementById('current-seat-tag')) {
                document.getElementById('current-seat-tag').innerText = seatTagMap[appState.activeSeat] || appState.activeSeat;
            }

            const cardBlockStarting = document.getElementById('card-block-starting');
            const cardBlockHand = document.getElementById('card-block-hand');

            if (isStartingMode) {
                if (cardBlockStarting) cardBlockStarting.classList.remove('hidden');
                if (cardBlockHand) cardBlockHand.classList.add('hidden');
            } else {
                if (cardBlockStarting) cardBlockStarting.classList.add('hidden');
                if (cardBlockHand) cardBlockHand.classList.remove('hidden');
            }

            if (document.getElementById('display-starting-pts')) {
                document.getElementById('display-starting-pts').innerText = `${activeStarting.toLocaleString('id-ID')} chip`;
                document.getElementById('display-starting-rp').innerText = formatRupiah(activeStarting * rate);
                document.getElementById('display-hand-pts').innerText = `${activeTotal.toLocaleString('id-ID')} chip`;
                document.getElementById('display-hand-rp').innerText = formatRupiah(activeTotal * rate);
            }

            if (document.getElementById('active-hand-mode-text')) {
                document.getElementById('active-hand-mode-text').innerText = isStartingMode ? 'Modal Chip' : 'Chip On Hand';
            }

            const copyBar = document.getElementById('copy-starting-all-bar');
            if (copyBar) {
                if (isStartingMode) {
                    copyBar.classList.remove('hidden');
                } else {
                    copyBar.classList.add('hidden');
                }
            }

            const seats = ['East', 'South', 'West', 'North'];
            let netSumTable = 0;

            const recapTabContainer = document.getElementById('recap-tab-players-list');
            if (recapTabContainer) recapTabContainer.innerHTML = '';

            seats.forEach(s => {
                const total = calculateSeatTotal(s);
                const starting = calculateSeatStartingTotal(s);
                const sHasFinal = Object.keys(appState.players[s] || {}).length > 0;
                const sNetPts = total - starting;
                const sNetRp = sNetPts * rate;
                const startingRp = starting * rate;
                const name = getPlayerName(s);

                if (sHasFinal) {
                    netSumTable += sNetPts;
                }

                if (document.getElementById(`seat-tab-name-${s}`)) {
                    document.getElementById(`seat-tab-name-${s}`).innerText = name;
                    
                    const seatStatusEl = document.getElementById(`seat-status-${s}`);
                    if (!sHasFinal) {
                        seatStatusEl.className = "text-[9px] font-mono-tabular px-1.5 py-0.2 bg-[#101310] text-[#777F73] rounded font-medium";
                        seatStatusEl.innerText = `0 chip`;
                    } else if (sNetPts > 0) {
                        seatStatusEl.className = "text-[9px] font-mono-tabular px-1.5 py-0.2 bg-[#242A23] text-[#78B58A] rounded font-bold border border-[#343B32]";
                        seatStatusEl.innerText = `+${sNetPts.toLocaleString('id-ID')}`;
                    } else if (sNetPts < 0) {
                        seatStatusEl.className = "text-[9px] font-mono-tabular px-1.5 py-0.2 bg-[#242A23] text-[#D77F79] rounded font-bold border border-[#343B32]";
                        seatStatusEl.innerText = `${sNetPts.toLocaleString('id-ID')}`;
                    } else {
                        seatStatusEl.className = "text-[9px] font-mono-tabular px-1.5 py-0.2 bg-[#101310] text-[#F0F0E7] rounded font-bold";
                        seatStatusEl.innerText = `${total.toLocaleString('id-ID')} chip`;
                    }
                }

                if (recapTabContainer) {
                    const card = document.createElement('div');
                    card.className = "bg-[#121612] p-3.5 rounded-lg border border-[#343B32] flex flex-col gap-3 shadow-sm";
                    
                    let statusBottomHTML = '';
                    if (!sHasFinal) {
                        statusBottomHTML = `
                            <div class="bg-[#171B17] p-3.5 rounded-xl border border-[#343B32] text-xs font-mono-tabular flex items-center justify-between shadow-md overflow-hidden relative">
                                <div>
                                    <span class="text-[10px] text-[#A5AA9E] block font-sans font-semibold uppercase tracking-wider">Status: Belum Diisi</span>
                                    <div class="text-[#A5AA9E] font-medium text-xs mt-0.5">-</div>
                                </div>
                                <div class="text-7xl sm:text-8xl flex items-center justify-center pl-2 select-none z-10 filter contrast-125">
                                    <span class="animate-draw inline-block">😐</span>
                                </div>
                            </div>
                        `;
                    } else if (sNetPts > 0) {
                        statusBottomHTML = `
                            <div class="bg-[#242A23] p-3.5 rounded-xl border border-[#343B32] text-xs font-mono-tabular flex items-center justify-between shadow-md overflow-hidden relative">
                                <div>
                                    <span class="text-[10px] text-[#78B58A] block font-sans font-bold uppercase tracking-wider">Menang</span>
                                    <div class="text-[#78B58A] font-bold text-sm sm:text-base mt-0.5">+${sNetPts.toLocaleString('id-ID')} chip (+${formatRupiah(sNetRp)})</div>
                                </div>
                                <div class="text-7xl sm:text-8xl flex items-center justify-center pl-2 select-none z-10 filter contrast-125">
                                    <div class="relative inline-block">
                                        <span class="animate-win inline-block">🥳</span>
                                        <span class="confetti-1">🎊</span>
                                        <span class="confetti-2">🎉</span>
                                    </div>
                                </div>
                            </div>
                        `;
                    } else if (sNetPts < 0) {
                        statusBottomHTML = `
                            <div class="bg-[#242A23] p-3.5 rounded-xl border border-[#343B32] text-xs font-mono-tabular flex items-center justify-between shadow-md overflow-hidden relative">
                                <div>
                                    <span class="text-[10px] text-[#D77F79] block font-sans font-bold uppercase tracking-wider">Kalah</span>
                                    <div class="text-[#D77F79] font-bold text-sm sm:text-base mt-0.5">${sNetPts.toLocaleString('id-ID')} chip (${formatRupiah(sNetRp)})</div>
                                </div>
                                <div class="text-7xl sm:text-8xl flex items-center justify-center pl-2 select-none z-10 filter contrast-125">
                                    <div class="relative inline-block animate-cry">
                                        <span>😭</span>
                                        <span class="tear-1">💧</span>
                                        <span class="tear-2">💧</span>
                                    </div>
                                </div>
                            </div>
                        `;
                    } else {
                        statusBottomHTML = `
                            <div class="bg-[#171B17] p-3.5 rounded-xl border border-[#343B32] text-xs font-mono-tabular flex items-center justify-between shadow-md overflow-hidden relative">
                                <div>
                                    <span class="text-[10px] text-[#C3A66A] block font-sans font-bold uppercase tracking-wider">Impas</span>
                                    <div class="text-[#C3A66A] font-bold text-sm sm:text-base mt-0.5">0 chip (Rp 0)</div>
                                </div>
                                <div class="text-7xl sm:text-8xl flex items-center justify-center pl-2 select-none z-10 filter contrast-125">
                                    <span class="animate-draw inline-block">😐</span>
                                </div>
                            </div>
                        `;
                    }

                    card.innerHTML = `
                        <div class="flex items-center justify-between pb-2 border-b border-[#343B32]">
                            <div class="flex items-center gap-2">
                                <span class="text-xs font-bold text-[#C3A66A] bg-[#171B17] px-2 py-0.5 rounded border border-[#343B32]">${s}</span>
                                <span class="text-xs sm:text-sm font-bold text-[#F0F0E7]">${name}</span>
                            </div>
                            <span class="text-[10px] font-mono-tabular text-[#A5AA9E]">Rate: ${formatRupiah(rate)}</span>
                        </div>
                        <div class="grid grid-cols-2 gap-2.5 text-xs font-mono-tabular">
                            <div class="bg-[#171B17] p-2.5 rounded-lg border border-[#343B32]">
                                <span class="text-[10px] text-[#A5AA9E] block font-sans font-semibold uppercase">Modal:</span>
                                <div class="font-bold text-[#F0F0E7] mt-1">${starting.toLocaleString('id-ID')} chip</div>
                                <div class="text-[11px] text-[#C3A66A] mt-0.5">${formatRupiah(startingRp)}</div>
                            </div>
                            <div class="bg-[#171B17] p-2.5 rounded-lg border border-[#343B32]">
                                <span class="text-[10px] text-[#A5AA9E] block font-sans font-semibold uppercase">On Hand:</span>
                                <div class="font-bold text-[#F0F0E7] mt-1">${sHasFinal ? `${total.toLocaleString('id-ID')} chip` : '-'}</div>
                                <div class="text-[11px] text-[#78B58A] mt-0.5">${sHasFinal ? formatRupiah(total * rate) : 'Belum diisi'}</div>
                            </div>
                        </div>
                        ${statusBottomHTML}
                    `;
                    recapTabContainer.appendChild(card);
                }
            });

            const balanceBadgeTab = document.getElementById('tab-recap-table-balance');
            const allPlayersEntered = seats.every(s => Object.keys(appState.players[s] || {}).length > 0);

            if (balanceBadgeTab) {
                if (!allPlayersEntered) {
                    balanceBadgeTab.className = "text-[10px] font-mono-tabular font-semibold px-2 py-1 rounded bg-[#121612] text-[#A5AA9E] border border-[#343B32]";
                    balanceBadgeTab.innerText = "Menunggu Semua Pemain";
                } else if (netSumTable === 0) {
                    balanceBadgeTab.className = "text-[10px] font-mono-tabular font-bold px-2 py-1 rounded bg-[#242A23] text-[#78B58A] border border-[#343B32]";
                    balanceBadgeTab.innerText = "✓ Meja Balance (0 chip)";
                } else if (netSumTable > 0) {
                    balanceBadgeTab.className = "text-[10px] font-mono-tabular font-bold px-2 py-1 rounded bg-[#242A23] text-[#C3A66A] border border-[#343B32]";
                    balanceBadgeTab.innerText = `⚠️ Selisih: +${netSumTable.toLocaleString('id-ID')} chip`;
                } else {
                    balanceBadgeTab.className = "text-[10px] font-mono-tabular font-bold px-2 py-1 rounded bg-[#242A23] text-[#D77F79] border border-[#343B32]";
                    balanceBadgeTab.innerText = `⚠️ Kurang: ${netSumTable.toLocaleString('id-ID')} chip`;
                }
            }

            const container = document.getElementById('chips-breakdown-container');
            if (container) {
                container.innerHTML = '';

                const activeChipEntries = Object.entries(currentHand)
                    .map(([chipKey, qty]) => [chipKey, qty, getNumericChipValue(chipKey)])
                    .sort((a, b) => a[2] - b[2]);

                if (activeChipEntries.length === 0) {
                    const emptyMsg = isStartingMode 
                        ? 'Belum ada chip modal. Ketuk tuts chip di bawah untuk menyusun modal awal.' 
                        : 'Tangan kosong. Ketuk tuts chip Vegas di bawah untuk menambahkan.';
                    container.innerHTML = `<span class="text-xs text-[#777F73] italic py-3 w-full text-center">${emptyMsg}</span>`;
                } else if (appState.handView === 'stacks') {
                    activeChipEntries.forEach(([chipKey, qty]) => {
                        const stackEl = document.createElement('div');
                        stackEl.className = "chip-stack-item flex flex-col items-center cursor-pointer group relative pt-3 px-0.5 mb-0.5 w-[64px]";
                        stackEl.onclick = () => removeSpecificChip(chipKey);
                        stackEl.title = `Ketuk untuk mengurangi 1x Chip ${chipKey}`;

                        let chipsStackHTML = '';
                        const visibleStackCount = Math.min(qty, 5);
                        for (let i = 0; i < visibleStackCount; i++) {
                            chipsStackHTML += `
                                <div class="absolute" style="bottom: ${i * 3.5}px; z-index: ${i}">
                                    ${generateChipSVG(chipKey, 42)}
                                </div>
                            `;
                        }

                        stackEl.innerHTML = `
                            <div class="w-12 h-14 relative flex items-end justify-center mb-1">
                                ${chipsStackHTML}
                            </div>
                            <span class="text-[9px] font-mono-tabular font-bold text-[#C3A66A] bg-[#101310] px-1.5 py-0.5 rounded border border-[#343B32] shadow-sm z-20">
                                x${qty}
                            </span>
                        `;
                        container.appendChild(stackEl);
                    });
                } else {
                    activeChipEntries.forEach(([chipKey, qty]) => {
                        const badge = document.createElement('div');
                        badge.className = "flex items-center gap-1.5 px-2 py-1 rounded-lg bg-[#121612] border border-[#343B32] text-xs font-mono-tabular font-semibold my-0.5";
                        badge.innerHTML = `
                            <div class="w-5 h-5 flex items-center justify-center">
                                ${generateChipSVG(chipKey, 22)}
                            </div>
                            <span class="text-[#F0F0E7]">${chipKey}</span>
                            <span class="bg-[#171B17] text-[#C3A66A] px-1 py-0.2 rounded text-[10px] font-bold border border-[#343B32]">x${qty}</span>
                            <button onclick="removeSpecificChip('${chipKey}')" class="ml-0.5 text-[#A5AA9E] hover:text-[#D77F79] text-sm font-bold">
                                &times;
                            </button>
                        `;
                        container.appendChild(badge);
                    });
                }
            }

            lucide.createIcons();
        }

        function removeSpecificChip(chipKey) {
            const isStartingMode = appState.targetMode === 'starting';
            const targetContainer = isStartingMode ? appState.startingChips : appState.players;
            const currentHand = targetContainer[appState.activeSeat];

            if (currentHand[chipKey] > 1) {
                currentHand[chipKey] -= 1;
            } else {
                delete currentHand[chipKey];
            }
            playChipSound();
            saveState();
            renderUI();
        }

        function copyStartingToAllPlayers() {
            const activeStartingHand = appState.startingChips[appState.activeSeat] || {};
            const seats = ['East', 'South', 'West', 'North'];
            
            showConfirmModal("Salin Modal Chip", `Salin susunan chip modal dari ${getPlayerName(appState.activeSeat)} ke SEMUA 4 pemain?`, () => {
                seats.forEach(s => {
                    appState.startingChips[s] = JSON.parse(JSON.stringify(activeStartingHand));
                });
                playChipSound();
                saveState();
                renderUI();
                showToast("Modal chip disalin ke semua pemain", "Copied All");
            });
        }

        function openSettingsModal() {
            document.getElementById('setting-chip-rate-input').value = appState.chipRate || 1000;
            document.getElementById('modal-settings').classList.remove('hidden');
        }

        function closeSettingsModal() {
            document.getElementById('modal-settings').classList.add('hidden');
        }

        function setChipRatePreset(val) {
            document.getElementById('setting-chip-rate-input').value = val;
        }

        function saveSettingsModal() {
            const rateVal = parseInt(document.getElementById('setting-chip-rate-input').value);
            if (!isNaN(rateVal) && rateVal > 0) {
                appState.chipRate = rateVal;
            }
            saveState();
            renderUI();
            closeSettingsModal();
            showToast(`Rate Chip: 1 chip = ${formatRupiah(appState.chipRate)}`, "Rate Set");
        }

        let pendingConfirmAction = null;

        function showConfirmModal(title, msg, onConfirm) {
            document.getElementById('confirm-title').innerText = title;
            document.getElementById('confirm-msg').innerText = msg;
            pendingConfirmAction = onConfirm;
            document.getElementById('modal-confirm').classList.remove('hidden');

            document.getElementById('btn-confirm-act').onclick = () => {
                if (pendingConfirmAction) pendingConfirmAction();
                closeConfirmModal(true);
            };
        }

        function closeConfirmModal(confirmed) {
            document.getElementById('modal-confirm').classList.add('hidden');
            pendingConfirmAction = null;
        }

        function confirmResetAll() {
            showConfirmModal("Reset Semua Data", "Hapus chip modal & chip on hand milik SEMUA pemain?", () => {
                appState.players = { East: {}, South: {}, West: {}, North: {} };
                appState.startingChips = { East: {}, South: {}, West: {}, North: {} };
                appState.history = [];
                saveState();
                renderUI();
            });
        }

        function saveState() {
            try {
                localStorage.setItem('mahjong_exchange_state_v7', JSON.stringify(appState));
            } catch (e) {}
        }

        function loadSavedState() {
            try {
                const saved = localStorage.getItem('mahjong_exchange_state_v7');
                if (saved) {
                    const parsed = JSON.parse(saved);
                    appState = { ...appState, ...parsed };
                }
            } catch (e) {}
        }
    </script>
</body>
</html>
